:{$PORT:80} {
	root * /app

	encode zstd gzip

	handle_path {$BASE:/}* {
		header /assets/* Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"
		header /favicon.ico Cache-Control "public, max-age=604800, s-maxage=604800"
		header /robots.txt Cache-Control "public, max-age=86400, s-maxage=86400"

		php_server

		rewrite / /src/index.php
		rewrite /api/ /src/index.php?{query}&json=1
		rewrite /dns-records /src/dns-records.php
		rewrite /login /src/login.php
		rewrite /manifest /src/manifest.php
	}

	respond 404
}
